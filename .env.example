# Database
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk"

# Server
PORT=8080
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-random-secret

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=

# Email (SendGrid or Mailgun — provider adapters come later)
SENDGRID_API_KEY=
EMAIL_FROM=support@yourdomain.com

# Inbound email webhook (shared secret for POST /api/webhooks/inbound-email)
INBOUND_WEBHOOK_SECRET=
