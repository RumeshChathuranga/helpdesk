# This file is for Docker Compose / deployment.
# For local dev without Docker, copy server/.env.example -> server/.env
# and client/.env.example -> client/.env instead.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk"

# Server
PORT=3000
NODE_ENV=development

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-random-secret

# GitHub Models (for AI classification, RAG replies, summaries, and reply polishing — o4-mini via GitHub Models)
GITHUB_MODELS_TOKEN=
# Optional overrides — defaults to o4-mini via GitHub Models' OpenAI-compatible endpoint.
# AI_MODEL=o4-mini
# AI_BASE_URL=https://models.inference.ai.azure.com

# Inbound email webhook (shared secret for POST /api/webhooks/inbound-email)
# At least 32 characters — generate with: openssl rand -base64 32
INBOUND_WEBHOOK_SECRET=

# Sentry Error Logging
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional override — only needed if the client's Sentry project lives in a
# different org than SENTRY_DSN above.
SENTRY_INGEST_ORIGIN=

# AI agent identity / branding
AI_AGENT_EMAIL=ai@cites.uom.lk
SUPPORT_EMAIL=cites@uom.lk
BRAND_NAME=University of Moratuwa — CITeS IT Help Desk

# Outbound email — see docs/email-setup.md for a full Gmail walkthrough.
EMAIL_DRIVER=log
EMAIL_FROM=cites@uom.lk
# Explicit and short — BRAND_NAME above is the long form used in AI prompts,
# not something we want as an SMTP display name.
EMAIL_FROM_NAME=CITeS Help Desk
EMAIL_REPLY_TO=cites@uom.lk
EMAIL_MESSAGE_ID_DOMAIN=uom.lk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
