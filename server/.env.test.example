# Test environment for `bun run test:server` / `bun run test:e2e`, and the
# file CI copies verbatim (see .github/workflows/ci.yml). Copy it to
# server/.env.test — that one is gitignored, this example is not.
#
# The database name must contain `helpdesk_test`: src/test/setup.ts refuses to
# run the suite otherwise, so tests can never touch the dev database.
#
#   cp server/.env.test.example server/.env.test
#   bun run db:test:setup   # prisma migrate deploy
#   bun run db:test:seed    # admin + agent + AI users, sample tickets

DATABASE_URL="postgresql://user:password@localhost:5433/helpdesk_test"
PORT=8080
NODE_ENV=test

BETTER_AUTH_SECRET=change-this-to-a-random-secret
BETTER_AUTH_URL=http://localhost:8080

CLIENT_URL=http://localhost:5173

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password

# Must be at least 32 characters, otherwise the webhook answers 503
INBOUND_WEBHOOK_SECRET=test-inbound-webhook-secret-32chars

# Never "smtp" here — tests and CI must never open a socket to a real
# mail provider. The default is already "log" outside production, but this
# is pinned explicitly as belt and braces.
EMAIL_DRIVER=log

# A placeholder, never a real credential: src/test/mockAi.ts swaps out both
# `ai` and `@ai-sdk/openai-compatible`, so no request leaves the process. The
# variable must still be *present* — getAiModel() returns null without it and
# the AI routes answer 500. Without this line the polish-reply/summarize tests
# only pass on a machine whose gitignored server/.env happens to hold a real
# token (Bun auto-loads it), and fail in CI, which has no server/.env.
GITHUB_MODELS_TOKEN=test-token-not-a-real-credential
