generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  AGENT
}

enum TicketStatus {
  NEW
  PROCESSING
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ACCOUNT_ACCESS
  EMAIL
  NETWORK
  WIFI_EDUROAM
  LMS_MOODLE
  LEARNORG_MIS
  ERP_DMS
  SOFTWARE_LICENSING
  ZOOM_CONFERENCING
  WEB_HOSTING
  HARDWARE
  OTHER
}

/// Affiliation of the person who raised the ticket, inferred from the sender
/// address on inbound email or set manually by an agent. Nullable — inference
/// is deliberately conservative and a wrong badge is worse than an empty one.
enum RequesterType {
  STUDENT
  ACADEMIC_STAFF
  ACADEMIC_SUPPORT_STAFF
  ADMINISTRATIVE_STAFF
  TECHNICAL_STAFF
  NON_ACADEMIC_STAFF
}

enum ReplyDirection {
  INBOUND
  OUTBOUND
}

/// Human-in-the-loop gate on outbound delivery. Only AI replies on
/// email-sourced tickets are ever created PENDING_APPROVAL (audit S6);
/// everything else is NOT_REQUIRED.
enum ReplyApprovalState {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  DISCARDED
}

enum EmailDeliveryState {
  NOT_QUEUED
  QUEUED
  SENDING
  SENT
  FAILED
}

/// Lifecycle of a knowledge document's chunk+embed pass. A document row exists
/// as soon as an admin submits it, so the UI can show it immediately; the
/// embed-document worker moves it PENDING -> PROCESSING -> READY (or FAILED).
enum KnowledgeStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          Role      @default(AGENT)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  assignedTickets Ticket[] @relation("AssignedAgent")
  createdTickets  Ticket[] @relation("CreatedBy")
  approvedReplies Reply[]  @relation("ApprovedReplies")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Ticket {
  id                String         @id @default(cuid())
  subject           String
  body              String
  status            TicketStatus   @default(NEW)
  category          TicketCategory @default(OTHER)
  fromEmail         String?
  fromName          String?
  externalMessageId String?        @unique
  aiSummary         String?
  requesterType     RequesterType?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedTo   User?   @relation("AssignedAgent", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String?

  replies Reply[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([category])
  @@index([assignedToId])
  @@index([requesterType])
}

model Reply {
  id                String   @id @default(cuid())
  body              String
  isAi              Boolean  @default(false)
  sentEmail         Boolean  @default(false)
  externalMessageId String?
  createdAt         DateTime @default(now())

  direction         ReplyDirection     @default(OUTBOUND)
  approval          ReplyApprovalState @default(NOT_REQUIRED)
  deliveryState     EmailDeliveryState @default(NOT_QUEUED)
  sentAt            DateTime?
  deliveryError     String?
  sendAttempts      Int                @default(0)
  lastSendAttemptAt DateTime?

  approvedBy   User?   @relation("ApprovedReplies", fields: [approvedById], references: [id])
  approvedById String?

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@index([externalMessageId])
  @@index([deliveryState])
  @@index([ticketId, approval])
}

/// An admin-authored knowledge base article. `text` is the full source; the
/// embed-document worker splits it into KnowledgeChunk rows sized to the
/// embedding model's 256-token window. Deleting a document deletes its chunks.
model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  text       String
  status     KnowledgeStatus  @default(PENDING)
  /// Last failure reason, set alongside status = FAILED.
  error      String?
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]

  @@index([createdAt])
  @@index([status])
}

/// One retrievable passage of a KnowledgeDocument. Written only through raw SQL
/// — `embedding` is Unsupported(), so the typed client cannot create these rows.
/// Two indexes serving RAG live in migration SQL only (Prisma cannot express
/// either): an HNSW index on `embedding` and a GIN index on
/// to_tsvector('english', text). See docs/db-indexing.md.
model KnowledgeChunk {
  id         String                    @id @default(cuid())
  documentId String
  chunkIndex Int
  text       String
  embedding  Unsupported("vector(384)")
  createdAt  DateTime                  @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}
