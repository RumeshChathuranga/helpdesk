generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  AGENT
}

enum TicketStatus {
  NEW
  PROCESSING
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BILLING
  TECHNICAL
  GENERAL
  FEATURE_REQUEST
  BUG
  OTHER
}

enum ReplyDirection {
  INBOUND
  OUTBOUND
}

/// Human-in-the-loop gate on outbound delivery. Only AI replies on
/// email-sourced tickets are ever created PENDING_APPROVAL (audit S6);
/// everything else is NOT_REQUIRED.
enum ReplyApprovalState {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  DISCARDED
}

enum EmailDeliveryState {
  NOT_QUEUED
  QUEUED
  SENDING
  SENT
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          Role      @default(AGENT)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  assignedTickets Ticket[] @relation("AssignedAgent")
  createdTickets  Ticket[] @relation("CreatedBy")
  approvedReplies Reply[]  @relation("ApprovedReplies")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Ticket {
  id                String         @id @default(cuid())
  subject           String
  body              String
  status            TicketStatus   @default(NEW)
  category          TicketCategory @default(OTHER)
  fromEmail         String?
  fromName          String?
  externalMessageId String?        @unique
  aiSummary         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedTo   User?   @relation("AssignedAgent", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String?

  replies Reply[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([category])
  @@index([assignedToId])
}

model Reply {
  id                String   @id @default(cuid())
  body              String
  isAi              Boolean  @default(false)
  sentEmail         Boolean  @default(false)
  externalMessageId String?
  createdAt         DateTime @default(now())

  direction         ReplyDirection     @default(OUTBOUND)
  approval          ReplyApprovalState @default(NOT_REQUIRED)
  deliveryState     EmailDeliveryState @default(NOT_QUEUED)
  sentAt            DateTime?
  deliveryError     String?
  sendAttempts      Int                @default(0)
  lastSendAttemptAt DateTime?

  approvedBy   User?   @relation("ApprovedReplies", fields: [approvedById], references: [id])
  approvedById String?

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@index([externalMessageId])
  @@index([deliveryState])
  @@index([ticketId, approval])
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  text      String
  embedding Unsupported("vector(384)")
}
