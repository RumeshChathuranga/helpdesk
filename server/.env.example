DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk"
PORT=3000
NODE_ENV=development
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

CLIENT_URL=http://localhost:5173

# Admin seed user (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password

# GitHub Models (for AI classification, RAG replies, summaries, and reply polishing — o4-mini via GitHub Models)
GITHUB_MODELS_TOKEN=

# Inbound email webhook (shared secret for POST /api/webhooks/inbound-email)
# At least 32 characters — generate with: openssl rand -base64 32
INBOUND_WEBHOOK_SECRET=
SENTRY_DSN=
# Optional override — only needed if the client's Sentry project lives in a
# different org than the server's SENTRY_DSN above.
SENTRY_INGEST_ORIGIN=

# AI agent identity / branding
AI_AGENT_EMAIL=ai@example.com
SUPPORT_EMAIL=support@example.com
BRAND_NAME=Helpdesk
