DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk"
PORT=3000
NODE_ENV=development
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

CLIENT_URL=http://localhost:5173

# Admin seed user (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password

# GitHub Models (for AI classification, RAG replies, summaries, and reply polishing — o4-mini via GitHub Models)
GITHUB_MODELS_TOKEN=
# Optional overrides — defaults to o4-mini via GitHub Models' OpenAI-compatible endpoint.
# AI_MODEL=o4-mini
# AI_BASE_URL=https://models.inference.ai.azure.com

# Knowledge base chunking + RAG retrieval — see docs/knowledge-base.md.
# Defaults are sane; uncomment to override.
# KB_CHUNK_MAX_TOKENS=200
# KB_CHUNK_OVERLAP_TOKENS=40
# RAG_TOP_K=3
# RAG_CANDIDATE_POOL=20
# RAG_SIMILARITY_THRESHOLD=0.75
# RAG_CONTEXT_CHAR_BUDGET=6000
# RAG_HYBRID_SEARCH=true

# Inbound email webhook (shared secret for POST /api/webhooks/inbound-email)
# At least 32 characters — generate with: openssl rand -base64 32
INBOUND_WEBHOOK_SECRET=
SENTRY_DSN=
# Optional override — only needed if the client's Sentry project lives in a
# different org than the server's SENTRY_DSN above.
SENTRY_INGEST_ORIGIN=

# AI agent identity / branding
AI_AGENT_EMAIL=ai@example.com
SUPPORT_EMAIL=support@example.com
BRAND_NAME=Helpdesk

# Outbound email — see docs/email-setup.md for a full Gmail walkthrough.
# EMAIL_DRIVER: "log" (default outside production — prints the composed
# message, never sends) or "smtp".
EMAIL_DRIVER=log
EMAIL_FROM=support@example.com
EMAIL_FROM_NAME=Helpdesk
EMAIL_REPLY_TO=support@example.com
EMAIL_MESSAGE_ID_DOMAIN=example.com

# SMTP (Gmail): smtp.gmail.com + a 2FA App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# IMAP poller (dev-only — `bun run --filter server email:poll`), used to test
# the reply loop against a real Gmail inbox. Defaults to the SMTP credentials.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_PROCESSED_MAILBOX=
IMAP_POLL_INTERVAL_MS=15000
IMAP_MAX_PER_POLL=25
INBOUND_WEBHOOK_URL=http://localhost:3000/api/webhooks/inbound-email
ALLOW_IMAP_POLLER=false
