{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bunx prisma generate",
    "dev": "bun --watch src/index.ts",
    "build": "echo 'Server build skipped, using bun runner directly'",
    "start": "bun src/index.ts",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:ai": "bun prisma/seed-ai.ts",
    "test:unit": "bun test src/routes",
    "test:server": "bun --env-file .env.test --env INBOUND_WEBHOOK_SECRET=test-inbound-webhook-secret src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.0.0",
    "@sentry/bun": "^10.63.0",
    "ai": "^7.0.14",
    "better-auth": "^1.5.6",
    "core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg-boss": "^12.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "bun-types": "^1.3.5",
    "prisma": "^7.0.0",
    "typescript": "^5.8.3"
  }
}
