{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bunx prisma generate",
    "dev": "bun --watch src/index.ts",
    "build": "echo 'Server build skipped, using bun runner directly'",
    "start": "bun src/index.ts",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:push": "bunx prisma db push",
    "db:studio": "bunx prisma studio",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:ai": "bun prisma/seed-ai.ts",
    "test:unit": "bun test src/routes",
    "test:server": "bun --env-file .env.test src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/bun": "^10.68.0",
    "ai": "^7.0.37",
    "better-auth": "^1.6.25",
    "core": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pg-boss": "^12.26.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "bun-types": "^1.3.14",
    "prisma": "^7.9.0",
    "typescript": "^5.9.3"
  }
}
