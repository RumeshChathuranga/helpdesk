{
  "name": "helpdesk",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/core"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter server dev",
    "dev:client": "bun run --filter client dev",
    "start": "bun run --filter server start",
    "build": "bun run --filter '*' build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "db:migrate:deploy": "bun run --filter server db:migrate:deploy",
    "db:studio": "bun run --filter server db:studio",
    "db:seed": "bun run --filter server db:seed",
    "db:seed:ai": "bun run --filter server db:seed:ai",
    "db:migrate": "bun run --filter server db:migrate",
    "db:push": "bun run --filter server db:push",
    "test:client": "bun run --filter client test",
    "test:server": "bun run --filter server test:unit",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:report": "bunx playwright show-report",
    "db:test:setup": "DATABASE_URL=$(grep DATABASE_URL server/.env.test | cut -d '\"' -f2) bunx prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:test:reset": "DATABASE_URL=$(grep DATABASE_URL server/.env.test | cut -d '\"' -f2) bunx prisma migrate reset --force --schema server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
